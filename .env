DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crime_evidence?schema=public"
JWT_SECRET="crime-evidence-dev-secret-change-in-production"

# Blockchain / IPFS integration. "mock" works with no external services;
# set to "fabric" / "kubo" to use a real Hyperledger Fabric network / IPFS daemon.
LEDGER_MODE="mock"
IPFS_MODE="mock"
