# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crime_evidence?schema=public"

# Secret used to sign JWTs — change in production
JWT_SECRET="change-me-in-production"

# Public URL of the frontend (used in QR verification links)
APP_PUBLIC_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Blockchain ledger: "mock" (hash-linked ledger in PostgreSQL) or "fabric"
# ---------------------------------------------------------------------------
LEDGER_MODE="mock"
# Only used when LEDGER_MODE=fabric (requires: npm install fabric-network)
CCP_PATH="./connection-org1.json"
WALLET_PATH="./wallet"
FABRIC_IDENTITY="appUser"
CHANNEL_NAME="crimechannel"
CHAINCODE_NAME="basic"
FABRIC_AS_LOCALHOST="true"

# ---------------------------------------------------------------------------
# IPFS storage: "mock" (content-addressed files on local disk) or "kubo"
# ---------------------------------------------------------------------------
IPFS_MODE="mock"
# Only used when IPFS_MODE=kubo
IPFS_URL="http://127.0.0.1:5001"
# Only used when IPFS_MODE=mock
IPFS_MOCK_DIR="./storage/ipfs"

# Log every SQL query (debugging)
PRISMA_LOG_QUERIES="false"
