{
  "name": "crime-evidence-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Crime Evidence Management System \u2014 exposes demo configuration as a resource with mutation tools",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:mcp": "node dist/index.js --mode mcp",
    "start:api": "node dist/index.js --mode api",
    "dev": "npx tsx src/index.ts",
    "dev:mcp": "npx tsx src/index.ts --mode mcp",
    "dev:api": "npx tsx watch src/index.ts --mode api",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "npx tsx scripts/seed-users.ts",
    "db:check": "npx tsx check-engine.ts",
    "test:acceptance": "npx tsx scripts/acceptance-test.ts"
  },
  "keywords": [
    "mcp",
    "crime-evidence",
    "blockchain",
    "hyperledger",
    "postgresql",
    "ipfs"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@prisma/adapter-pg": "~7.4.0",
    "@prisma/client": "^7.4.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "prisma": "^7.4.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
