generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                 @id @default(uuid())
  username          String                 @unique
  email             String                 @unique
  fullName          String
  badgeNumber       String?
  department        String?
  role              String
  passwordHash      String
  mfaEnabled        Boolean                @default(false)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  accessLogs        AccessLog[]
  custodyEventsTo   CustodyEvent[]         @relation("ToUser")
  custodyEventsFrom CustodyEvent[]         @relation("FromUser")
  custodiedEvidence Evidence[]             @relation("CurrentCustodian")
  collectedEvidence Evidence[]             @relation("CollectedBy")
  createdBoxes      CrimeBox[]             @relation("BoxCreator")
  createdCases      Case[]                 @relation("CaseCreator")
  comments          EvidenceComment[]
  accessRequests    EvidenceAccessRequest[] @relation("Requester")
  reviewedRequests  EvidenceAccessRequest[] @relation("Reviewer")
  labResults        LabResult[]
  notifications      Notification[]
  activityLogs      ActivityLog[]
  destructionRequests DestructionRequest[] @relation("DestructionRequester")
  reviewedDestructions DestructionRequest[] @relation("DestructionReviewer")
  caseAssignments   CaseOfficer[]          @relation("CaseOfficerUser")
  caseAssignmentsMade CaseOfficer[]        @relation("CaseOfficerAddedBy")
  evidenceVersions  EvidenceVersion[]
}

model Case {
  id          String     @id @default(uuid())
  caseNumber  String?    @unique
  title       String
  description String?
  status      String     @default("open")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String
  createdBy   User       @relation("CaseCreator", fields: [createdById], references: [id])
  crimeBoxes  CrimeBox[]
  evidence    Evidence[]
  officers    CaseOfficer[]
}

// Officers assigned to a case (e.g. COLLECTOR, FORENSIC_ANALYST added by the PROSECUTOR)
model CaseOfficer {
  id          String   @id @default(uuid())
  caseId      String
  userId      String
  addedById   String
  createdAt   DateTime @default(now())
  caseRef     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user        User     @relation("CaseOfficerUser", fields: [userId], references: [id])
  addedBy     User     @relation("CaseOfficerAddedBy", fields: [addedById], references: [id])

  @@unique([caseId, userId])
  @@index([userId])
}

model CrimeBox {
  id          String   @id @default(uuid())
  name        String
  caseId      String   @unique
  privateKey  String   @unique
  publicKey   String   @unique
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("BoxCreator", fields: [createdById], references: [id])
  caseRef     Case?    @relation(fields: [caseRefId], references: [id])
  caseRefId   String?
}

model Evidence {
  id                 String                  @id @default(uuid())
  // Human-readable ID used as the Fabric asset ID (e.g. EVID_2026_001)
  evidenceNumber     String?                 @unique
  // Free-form case identifier (Case.id, Case.caseNumber or a Crime Box caseId)
  caseId             String
  // Resolved link to a Case row, when caseId matches one
  caseRefId          String?
  type               String
  description        String
  collectionDate     DateTime
  location           String
  tags               String?
  officerName        String?
  // SHA-256 of the primary evidence file
  fileHash           String?
  // SHA-256 of the canonical metadata document stored on IPFS
  metadataHash       String?
  // CID of the latest metadata document on IPFS (the pointer stored on the ledger)
  ipfsCid            String?
  // Latest ledger transaction ID for this evidence asset
  ledgerTxId         String?
  // PENDING | ANCHORED | FAILED
  anchorStatus       String                  @default("PENDING")
  version            Int                     @default(0)
  status             String
  locked             Boolean                 @default(false)
  officerNotes       String?
  retentionDeadline  DateTime?
  retentionPolicy    String?
  allowedRoles       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  collectedById      String
  currentCustodianId String
  accessLogs         AccessLog[]
  custodyEvents      CustodyEvent[]
  currentCustodian   User                    @relation("CurrentCustodian", fields: [currentCustodianId], references: [id])
  collectedBy        User                    @relation("CollectedBy", fields: [collectedById], references: [id])
  files              EvidenceFile[]
  comments           EvidenceComment[]
  accessRequests     EvidenceAccessRequest[]
  labResults         LabResult[]
  destructionRequests DestructionRequest[]
  versions           EvidenceVersion[]
  caseRef            Case?                   @relation(fields: [caseRefId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([caseRefId])
  @@index([status])
}

model CustodyEvent {
  id         String   @id @default(uuid())
  eventType  String
  reason     String
  status     String
  signature  String?
  timestamp  DateTime @default(now())
  evidenceId String
  fromUserId String
  toUserId   String
  toUser     User     @relation("ToUser", fields: [toUserId], references: [id])
  fromUser   User     @relation("FromUser", fields: [fromUserId], references: [id])
  evidence   Evidence @relation(fields: [evidenceId], references: [id])
}

model AccessLog {
  id         String   @id @default(uuid())
  action     String
  ipAddress  String?
  userAgent  String?
  result     String
  timestamp  DateTime @default(now())
  evidenceId String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  evidence   Evidence @relation(fields: [evidenceId], references: [id])
}

model EvidenceFile {
  id         String   @id @default(uuid())
  fileName   String
  fileSize   Int
  mimeType   String
  sha256Hash String
  ipfsCid    String?
  // Location of the stored copy on local disk (relative to the uploads directory)
  storagePath String?
  uploadedAt DateTime @default(now())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id])
}

model EvidenceComment {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  evidenceId String
  userId     String
  evidence   Evidence @relation(fields: [evidenceId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model EvidenceAccessRequest {
  id          String    @id @default(uuid())
  reason      String
  status      String    @default("pending")
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  evidenceId  String
  requesterId String
  reviewerId  String?
  evidence    Evidence  @relation(fields: [evidenceId], references: [id])
  requester   User      @relation("Requester", fields: [requesterId], references: [id])
  reviewer    User?     @relation("Reviewer", fields: [reviewerId], references: [id])
}

model LabResult {
  id            String   @id @default(uuid())
  title         String
  summary       String
  findings      String?
  fileUrl       String?
  submittedAt   DateTime @default(now())
  evidenceId    String
  submittedById String
  evidence      Evidence @relation(fields: [evidenceId], references: [id])
  submittedBy   User     @relation(fields: [submittedById], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String
  actorName   String
  action      String
  entityType  String
  entityId    String
  entityLabel String?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id])
}

model DestructionRequest {
  id            String    @id @default(uuid())
  evidenceId    String
  requesterId   String
  reason        String
  status        String    @default("pending")
  reviewNotes   String?
  reviewedAt    DateTime?
  reviewerId    String?
  certificate   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  evidence      Evidence  @relation(fields: [evidenceId], references: [id])
  requester     User      @relation("DestructionRequester", fields: [requesterId], references: [id])
  reviewer      User?     @relation("DestructionReviewer", fields: [reviewerId], references: [id])

  @@index([evidenceId])
  @@index([requesterId])
  @@index([status])
}

// Immutable snapshot of an evidence item after each change (version history)
model EvidenceVersion {
  id            String   @id @default(uuid())
  evidenceId    String
  version       Int
  action        String
  changedById   String?
  changedByName String
  notes         String?
  snapshot      Json
  metadataHash  String
  metadataCid   String?
  ledgerTxId    String?
  createdAt     DateTime @default(now())
  evidence      Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([evidenceId, version])
}

// Local index of every ledger transaction. In mock mode this table is the ledger;
// each row is hash-linked to the previous one so tampering is detectable.
model LedgerTransaction {
  id          String   @id @default(uuid())
  txId        String   @unique
  blockNumber Int      @unique
  assetId     String
  function    String
  cid         String?
  payloadHash String
  prevHash    String
  blockHash   String
  mode        String
  createdAt   DateTime @default(now())

  @@index([assetId])
}

// Security audit trail — logins, logouts, every write request and every denial
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  username    String?
  role        String?
  action      String
  method      String?
  path        String?
  statusCode  Int?
  entityType  String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// JWTs invalidated by logout
model RevokedToken {
  jti       String   @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([expiresAt])
}

// Named counters for human-readable IDs (EVID_2026_001, CASE_2026_001)
model Counter {
  name  String @id
  value Int    @default(0)
}
